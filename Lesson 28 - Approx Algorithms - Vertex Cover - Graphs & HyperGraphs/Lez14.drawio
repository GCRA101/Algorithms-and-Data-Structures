        <mxCell id="OiW7I33y55dAUQwYD2B5-5865" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;PROBLEMA&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Siano date 10 legioni dell&#39;Antica Roma (nodi) di cui e&#39; noto il costo di mantenimento (peso dei nodi) e le Province dell&#39;Impero (iper-archi) in cui possono prestare servizio sulla base di conoscenza del territorio. Si modelli il problema tramite un iper-grafo pesato, se ne costruiscano le rappresentazioni sotto forma di Grafo di Eulero Pesato, Grafo Bipartito di Incidenza Pesato e Matrice di Incidenza Pesata.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Si risolva il problema di Vertex Cover andando a trovare il numero minimo di legioni che consenta di difendere tutte le province al minimo costo totale possibile.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="113" width="1660" x="4450" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5866" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;PROBLEMA&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Sia dato un Iper-Grafo di 7 nodi (da A a G) e 5 iper-archi (da 01 a 05).&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Si modelli il problema tramite un iper-grafo pesato, se ne costruiscano le rappresentazioni sotto forma di Grafo di Eulero Pesato, Grafo Bipartito di Incidenza Pesato e Matrice di Incidenza Pesata.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;Si risolva il problema di Vertex Cover andando a trovare il numero minimo di nodi per coprire tutti gli iper-archi dell&#39;iper-grafo.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="1660" x="4400" y="-260" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5869" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#4d4d4d&quot;&gt;&lt;i style=&quot;&quot;&gt;Vettore dei Pesi dei Nodi&lt;/i&gt;&lt;/font&gt;" vertex="1">
