          <mxGeometry height="10" width="30" x="3137.33" y="4474.67" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5650" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#E6E6E6,#FFFF33);shadow=1;fontColor=#808080;strokeColor=light-dark(#808080,#66B2FF);align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" value="&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;w=4&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="10" width="30" x="3428.33" y="4474.67" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5651" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#E6E6E6,#FFFF33);shadow=1;fontColor=#808080;strokeColor=light-dark(#808080,#66B2FF);align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" value="&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;w=15&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="10" width="30" x="3288.33" y="4380.67" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5656" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;PROBLEMA&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Sia data una rete sociale di persone (nodi) di cui sono noti il numero di contatti/incontri reciproci settimanali (peso degli archi) e il livello di resistenza fisica alla contrazione di una specifica malattia epidemica da 1 a 20 (peso dei nodi). Si modelli il problema tramite un grafo pesato, se ne costruisca la matrice di adiacenza, la lista di adiacenza, la lista degli archi e il vettore dei pesi dei nodi.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Si risolva il problema di Vertex cover andando a trovare il numero minimo di persone da visitare in un primo round di visite di emergenza.&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Si considerino contatti a rischio solo quelli con frequenza &amp;gt;= 2 volte alla settimana e si dia la precedenza ai soggetti piu&#39; deboli (minor costo nodi).&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="113" width="1660" x="320" y="3090" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5657" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;PROBLEMA&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Sia data una squadra di calciatori (nodi) di cui sono noti il numero di passaggi reciproci ogni 10 mins (peso degli archi) e il numero di marcatori necessari per marcarli (peso dei nodi). Si modelli il problema tramite un grafo pesato, se ne costruisca la matrice di adiacenza, la lista di adiacenza, la lista degli archi e il vettore dei pesi dei nodi.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Si risolva il problema di Vertex Cover andando a trovare il numero minimo di calciatori da marcare per coprire tutti gli archi con peso superiore a 5 (vie di passaggio palla preferenziali) dando precedenza ai giocatori che richiedono marcartura piu&#39; leggera (minor numero di marcatori richiesti).&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="113" width="1660" x="320" y="1100" as="geometry" />
        </mxCell>
