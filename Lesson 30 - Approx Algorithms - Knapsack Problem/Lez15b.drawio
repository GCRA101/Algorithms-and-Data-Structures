        <mxCell id="Hxafv98q6EFaidvqAuXY-3669" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;TEMPO DI ESECUZIONE&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;t&lt;/span&gt;&lt;sub style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;TOT&lt;/font&gt;&lt;/sub&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;~&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i&gt;&lt;b&gt;2 ms&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
