        <mxCell id="Hxafv98q6EFaidvqAuXY-3793" parent="1" style="connectable=0;recursiveResize=0;strokeColor=#000000;fillColor=light-dark(#8AE6E4,#CC0066);align=left;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=8;fontStyle=0;fontFamily=Helvetica;fontColor=default;" value="20.000" vertex="1">
