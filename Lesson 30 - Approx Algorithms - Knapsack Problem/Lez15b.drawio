        <mxCell id="Hxafv98q6EFaidvqAuXY-3670" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 30px; color: rgb(77, 77, 77);&quot;&gt;&lt;b&gt;PROBLEMA 02&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;i&gt;Inserimento libri in uno scaffale con valori dell&#39;ordine di 10&lt;sup&gt;5&lt;/sup&gt;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="1500" x="5011.51" y="2360" as="geometry" />
        </mxCell>
        <mxCell id="Hxafv98q6EFaidvqAuXY-3671" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;exitX=0;exitY=1;exitDx=0;exitDy=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="5005.76" y="2443" as="sourcePoint" />
            <mxPoint x="8325.75" y="2440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Hxafv98q6EFaidvqAuXY-3672" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;PROBLEMA&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;i&gt;Si considerino 30 libri su diversi argomenti tra cui informatica teorica, informatica pratica, studio della lingua latina, storia di Roma antica e arti marziali.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;i&gt;Ciascun libro ha uno spessore (costo dell&#39;oggetto) e un valore (punteggio di interesse) dell&#39;ordine di 10&lt;sup&gt;5&lt;/sup&gt;: la base dipende dall&#39;argomento (da 20.000 a 100.000) e a essa si aggiunge una variazione propria del libro.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;i&gt;Il limite totale di costo e&#39; rappresentato dalla larghezza dello scaffale di 60cm. Trovare i libri da inserire massimizzando il valore totale.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;i&gt;Risolvere il problema con l&#39;algoritmo esatto (DP sui valori) e con l&#39;algoritmo approssimato per &amp;epsilon; = 0.9, 0.5 e 0.25, confrontando celle della tabella e tempi di esecuzione.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="1700" x="5045.76" y="2470" as="geometry" />
        </mxCell>
