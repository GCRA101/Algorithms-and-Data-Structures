        <mxCell id="Hxafv98q6EFaidvqAuXY-3567" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;PARAMETRI&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i&gt;ε = 3/4, n = 30, v&lt;sub&gt;max&lt;/sub&gt; = 10&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i&gt;b = ε·v&lt;sub&gt;max&lt;/sub&gt;/(2n) = 1/8&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i&gt;valori scalati ⌈v/b⌉ = 8·v (v&lt;sub&gt;max&lt;/sub&gt; scalato = 80)&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i&gt;b &amp;lt; 1: lo scalamento non riduce i valori, stessa soluzione dell&#39;esatta&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="7280" y="1520" as="geometry" />
        </mxCell>
