        <mxCell id="Hxafv98q6EFaidvqAuXY-3309" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;i&gt;opt[i][v] = costo minimo (spessore, cm) per ottenere valore esattamente v con i primi i libri (i = posizione nella Lista Oggetti)&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;i&gt;&amp;#8734; = non ottenibile &amp;middot; righe con v dispari omesse (valori tutti pari: &amp;#8734; ovunque) &amp;middot; rosso = ricostruzione, cella scura = ottimo v = 174 (opt = 80 &amp;#8804; 80)&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
