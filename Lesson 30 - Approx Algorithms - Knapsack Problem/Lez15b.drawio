        <mxCell id="Hxafv98q6EFaidvqAuXY-3475" parent="1" style="connectable=0;recursiveResize=0;strokeColor=#000000;fillColor=#F5A89A;align=center;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=8;fontStyle=0;fontFamily=Helvetica;fontColor=default;" value="2" vertex="1">
