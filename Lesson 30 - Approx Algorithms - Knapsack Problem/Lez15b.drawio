        <mxCell id="ej1MDt5pkSOGeG6L5-XA-17" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#4d4d4d&quot;&gt;&lt;i style=&quot;&quot;&gt;Tabella di Programmazione Dinamica&lt;/i&gt;&lt;/font&gt;" vertex="1">
