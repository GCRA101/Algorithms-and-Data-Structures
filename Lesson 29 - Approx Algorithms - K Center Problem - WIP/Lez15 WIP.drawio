        <mxCell id="C2jUnQ8hAe2mOVvei_Nr-474" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;i&gt;VERSIONE CLASSICA: CONSIDERANDO il PESO degli ARCHI (nessun peso sui nodi)...&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="770" x="2390" y="1979.9499999999998" as="geometry" />
        </mxCell>
        <mxCell id="C2jUnQ8hAe2mOVvei_Nr-475" edge="1" parent="1" source="C2jUnQ8hAe2mOVvei_Nr-474" style="endArrow=none;html=1;rounded=0;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.844;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" target="C2jUnQ8hAe2mOVvei_Nr-474" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="2440.95" y="2009.9499999999998" as="sourcePoint" />
            <mxPoint x="2842.899999999998" y="2009.9499999999998" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="C2jUnQ8hAe2mOVvei_Nr-478" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;i&gt;Soluzione Approssimata&amp;nbsp;&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i style=&quot;background-color: transparent; font-size: 15px; color: rgb(77, 77, 77);&quot;&gt;-&amp;nbsp;&amp;nbsp;&lt;b&gt;T(n,m,d) =&amp;nbsp;&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;&lt;b style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;i&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;O(k&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;·(n+m)&lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;·logn&lt;/span&gt;&lt;/span&gt;)&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="750" x="3250" y="3674.33" as="geometry" />
        </mxCell>
        <mxCell id="ieaXhAH7w2GCMVe6ve-O-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Posti al cinema o in aula con distanziamento.&lt;/strong&gt;&amp;nbsp;&lt;div&gt;Piazzi le persone una alla volta nel posto più lontano da chi è già seduto.&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="560" x="321.5400000000001" y="4100.54" as="geometry" />
        </mxCell>
        <mxCell id="ieaXhAH7w2GCMVe6ve-O-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Intelligenza artificiale (selezione dei dati).&lt;/strong&gt;&amp;nbsp;&lt;div&gt;Hai milioni di immagini non etichettate e puoi pagare qualcuno per etichettarne solo k. Si scelgono con il k-center greedy, così il campione copre tutta la varietà del dataset (metodo &lt;em&gt;core-set&lt;/em&gt; per l’active learning, Sener e Savarese 2018).&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="321.5400000000001" y="4161.540000000001" as="geometry" />
        </mxCell>
        <mxCell id="ieaXhAH7w2GCMVe6ve-O-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Nuvole di punti 3D, auto a guida autonoma e robot.&lt;/strong&gt;&amp;nbsp;&lt;div&gt;Una scansione LiDAR ha centinaia di migliaia di punti e la rete neurale ne gestisce solo qualche migliaio. Il &lt;em&gt;farthest point sampling&lt;/em&gt;, usato ad esempio in PointNet++, è esattamente questo greedy: tiene i punti più distanti tra loro e quindi la forma complessiva dell’oggetto.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="560" x="321.5400000000001" y="4232.540000000001" as="geometry" />
        </mxCell>
        <mxCell id="ieaXhAH7w2GCMVe6ve-O-5" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Pizzerie in una città&lt;/strong&gt;&lt;div&gt;Dati i quartieri di Milano come punti, dove aprire k=4 punti vendita per minimizzare la distanza massima da un cliente?&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="560" x="321.5400000000001" y="4400.540000000001" as="geometry" />
        </mxCell>
        <mxCell id="ieaXhAH7w2GCMVe6ve-O-6" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;strong&gt;Reti Sociali&lt;/strong&gt;&lt;/div&gt;&lt;strong&gt;Landmark per stimare le distanze in grafi enormi&lt;/strong&gt;: si scelgono k nodi “faro” lontani tra loro, si precalcolano le distanze da questi, e poi si stima la distanza tra due utenti qualsiasi tramite i landmark. La selezione farthest-first è una delle strategie classiche." vertex="1">
          <mxGeometry height="70" width="560" x="321.5400000000001" y="4466.540000000001" as="geometry" />
        </mxCell>
        <mxCell id="ieaXhAH7w2GCMVe6ve-O-7" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Reti di sensori IoT&lt;/strong&gt;&lt;div&gt;Scelta dei nodi &lt;em&gt;cluster head&lt;/em&gt; o dei punti di raccolta dati, in modo che nessun sensore sia troppo lontano da un riferimento.&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="560" x="321.5400000000001" y="4552.540000000001" as="geometry" />
        </mxCell>
        <mxCell id="ieaXhAH7w2GCMVe6ve-O-8" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Postazioni di ambulanze o elicotteri di soccorso&lt;/strong&gt;&lt;div&gt;In una regione montuosa, così che nessun paese sia troppo lontano dalla postazione più vicina. È il classico k-center nella pianificazione dei servizi di emergenza.&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="321.5400000000001" y="4619.540000000001" as="geometry" />
        </mxCell>
        <mxCell id="ieaXhAH7w2GCMVe6ve-O-10" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Accampamenti legionari lungo i confini&lt;/strong&gt; &lt;em&gt;(modello)&lt;/em&gt;: dati i punti del limes (Reno, Danubio, Vallo di Adriano) e i luoghi sensibili, si scelgono k basi che minimizzino la distanza massima da cui una legione deve intervenire. Utile per confrontare il modello con la distribuzione storica reale delle legioni." vertex="1">
          <mxGeometry height="80" width="560" x="321.5400000000001" y="4690.540000000001" as="geometry" />
        </mxCell>
        <mxCell id="ieaXhAH7w2GCMVe6ve-O-1517" edge="1" parent="1" source="ieaXhAH7w2GCMVe6ve-O-1548" style="rounded=1;html=1;labelBackgroundColor=none;startArrow=none;startFill=0;endArrow=none;endFill=1;jettySize=auto;orthogonalLoop=1;strokeColor=light-dark(#534b4b, #ededed);strokeWidth=2;fontFamily=Verdana;fontSize=12;align=center;verticalAlign=middle;fontColor=default;" target="ieaXhAH7w2GCMVe6ve-O-1549" value="">
