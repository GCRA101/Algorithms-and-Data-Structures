        <mxCell id="OiW7I33y55dAUQwYD2B5-2997" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;br&gt;&lt;strong&gt;Point Cloud&lt;/strong&gt;&lt;div&gt;&lt;strong&gt;Campionamento di superfici e mesh&lt;/strong&gt; per grafica 3D e remeshing: si ottengono punti ben distribuiti, simili a un campionamento Poisson-disk.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="560" x="321.5400000000001" y="4329.540000000001" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-2998" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;exitX=0;exitY=1;exitDx=0;exitDy=0;strokeWidth=3;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="279.99" y="-467" as="sourcePoint" />
