        </mxCell>
        <mxCell id="C2jUnQ8hAe2mOVvei_Nr-472" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;i&gt;VARIANTE con PESI ADDITIVI SUI NODI&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;" vertex="1">
