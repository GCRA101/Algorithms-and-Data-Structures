          </mxGeometry>
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5287" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;b&gt;PESO ARCHI&lt;/b&gt;&lt;/span&gt;:&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;i style=&quot;color: rgb(77, 77, 77); font-size: 16px;&quot;&gt;Giorni di navigazione per raggiungere l&#39;isola&lt;/i&gt;" vertex="1">
          <mxGeometry height="40" width="450" x="320" y="2654.33" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5288" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;NOTE IMPORTANTI&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;La versione classica dell&#39;algoritmo approssimante di selezione dei centri (Gonzalez) considera solo pesi sugli archi...non sui nodi!&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Se si considerano i pesi sui nodi semplicemente come additivi al peso degli archi (solo quando il nodo e&#39; destinazione del cammino) si puo&#39; usare ancora Gonzalez. Trattasi di u&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;i style=&quot;font-size: 16px; color: rgb(77, 77, 77); background-color: transparent;&quot;&gt;na variante della versione classica senza un nome specifico in letteratura e non garantisce un rapporto di approssimazione costante.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 16px; color: rgb(77, 77, 77); background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 16px; color: rgb(77, 77, 77); background-color: transparent;&quot;&gt;Per una versione propriamente pesata del K-Center bisogna usare l&#39;algoritmo greedy di Plesnik.&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="598.34" x="320" y="2784.33" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5289" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;b&gt;PESO NODI&lt;/b&gt;&lt;/span&gt;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Giorni di cammino per raggiungere il monastero [&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;font-size: 16px;&quot;&gt;k-Center -&lt;/i&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&amp;nbsp;Gonzalez (1985)]&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Priorita&#39; del monastero [&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i&gt;Weighted k-Center -&amp;nbsp;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i&gt;Plesník (1987)]&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="72.52" width="560" x="320" y="2704.33" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5322" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#4d4d4d&quot;&gt;&lt;i style=&quot;&quot;&gt;Vettore dei Pesi dei Nodi&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="221.99" x="1880" y="2644.33" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5323" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="1880" y="2684.33" as="sourcePoint" />
            <mxPoint x="2160" y="2684.33" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5656" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;PROBLEMA&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Nel regno di Ayutthaya, l&#39;antico esercito siamese deve proteggere i tesori (statue d&#39;oro del Buddha e gioielli) custoditi nei monasteri buddisti di 16 isole del Mare delle Andamane (nodi).&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Le isole sono collegate da rotte con peso pari ai giorni di navigazione delle giunche da guerra (peso degli archi). Il peso dei nodi corrisponde ai giorni di cammino per raggiungere il monastero (algoritmo greedy di Gonzalez) oppure la priorita&#39;/importanza del monastero (algoritmo greedy di Plesnik).&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Il re può stabilire 5 guarnigioni, ciascuna su una delle isole. Ogni monastero sarà protetto dalla guarnigione più vicina, misurata in giorni di navigazione sul cammino minimo (Dijkstra).&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Calcolare dove e&#39; meglio collocare le 5 guarnigioni per minimizzare il numero massimo di giorni che separano un monastero dalla sua guarnigione.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;Si utilizzi l&#39;algoritmo greedy approssimato di Gonzalez (1985) per il caso non pesato e l&#39;algoritmo approssimato di Plesnik (1987) per il caso pesato.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;i style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;Si confrontino i risultati con l&#39;algoritmo esatto di&lt;/i&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&amp;nbsp;forza bruta.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="1510" x="320" y="1740" as="geometry" />
        </mxCell>
        <mxCell id="OiW7I33y55dAUQwYD2B5-5657" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;PROBLEMA&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;i&gt;Si considerino 20 aeroporti (nodi) collegati da un arco se tra essi e&#39; presente un volo diretto.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;color: rgb(77, 77, 77); font-size: 16px;&quot;&gt;&lt;i&gt;Si modelli il problema tramite un grafo non pesato, se ne costruisca la matrice di adiacenza, la lista di adiacenza e la lista degli archi.&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Si risolva il problema di Selezione dei Centri (k-center) andando a scegliere i&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: rgb(77, 77, 77); font-size: 16px;&quot;&gt;&lt;i&gt;&amp;nbsp;k = 3 hub migliori affinche&#39; da qualunque aeroporto si possa raggiungere un hub con il minor numero di scali.&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(77, 77, 77); font-size: 16px;&quot;&gt;&lt;i&gt;&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: rgb(77, 77, 77); font-size: 16px;&quot;&gt;&lt;i&gt;Si utilizzi l&#39;algoritmo greedy approssimato di Gonzalez (1985) e si confronti il risultato con l&#39;algoritmo esatto di Enumerazione.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="113" width="1330" x="320" y="-250" as="geometry" />
        </mxCell>
