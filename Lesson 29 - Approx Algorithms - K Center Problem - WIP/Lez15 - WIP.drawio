        <mxCell id="C2jUnQ8hAe2mOVvei_Nr-471" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;i&gt;Selezione dei K Centri (K-Center)&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="440" x="2370" y="1902.9499999999998" as="geometry" />
        </mxCell>
        <mxCell id="C2jUnQ8hAe2mOVvei_Nr-472" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;i&gt;VARIANTE con PESI ADDITIVI SUI NODI&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="401" x="2400.0000000000005" y="3583.13" as="geometry" />
        </mxCell>
        <mxCell id="C2jUnQ8hAe2mOVvei_Nr-473" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;exitX=0;exitY=1;exitDx=0;exitDy=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
