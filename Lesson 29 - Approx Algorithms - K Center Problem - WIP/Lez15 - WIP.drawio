        <mxCell id="C2jUnQ8hAe2mOVvei_Nr-468" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;i style=&quot;&quot;&gt;Soluzione&amp;nbsp;&lt;/i&gt;&lt;/font&gt;&lt;i style=&quot;color: rgb(77, 77, 77); font-size: 15px; background-color: transparent;&quot;&gt;Ottima&amp;nbsp; -&amp;nbsp;&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;background-color: transparent; color: rgb(77, 77, 77); font-size: 15px;&quot;&gt;&lt;b&gt;T(n,m,d) = O((2^n)·m)&lt;/b&gt;&lt;/i&gt;" vertex="1">
