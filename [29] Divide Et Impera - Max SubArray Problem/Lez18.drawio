        <mxCell id="OiW7I33y55dAUQwYD2B5-5657" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;PROBLEMA&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Dato il numero di passaggi riusciti da un calciatore in ognuno dei 18&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;intervalli di 5 minuti di una partita (da 0-5 a 85-90) e una soglia di&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;riferimento (il numero medio di passaggi riusciti per intervallo), trovare gli&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;intervalli consecutivi in cui il calciatore supera di più la soglia, cioè il&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;periodo della partita in cui ha giocato meglio. Descrivere un algoritmo divide&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;et impera che risolva il problema e valutarne la complessità.&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Perché si sottrae la soglia?&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;I passaggi riusciti sono tutti positivi, quindi il sottovettore massimo sarebbe&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;l&#39;intera partita.&amp;nbsp;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;Sottraendo la media, ogni valore diventa il surplus&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;(positivo) o il deficit (negativo) di quell&#39;intervallo, e la somma su un tratto&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;è il surplus cumulato dei suoi intervalli.&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="1370" x="320" y="-250" as="geometry" />
        </mxCell>
