          </mxGeometry>
        </mxCell>
        <mxCell id="tdvXAdWJLCsfj8oNXYt1-89" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;&lt;i&gt;PROBLEMA&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Dato il flusso orario di visitatori della Fontana di Trevi dalle 6 alle 24 e&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;una soglia di affollamento (la capienza sicura), trovare le fasce orarie&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;consecutive in cui il flusso supera di più la soglia,&amp;nbsp;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;cioè dove è necessario&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;controllare gli accessi.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Perché si sottrae la soglia?&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;I flussi sono tutti positivi, quindi il sottovettore massimo sarebbe l&#39;intera&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;giornata.&amp;nbsp;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;Sottraendo la capienza, ogni valore diventa l&#39;eccesso (positivo) o il&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;margine libero (negativo) di quell&#39;ora, e la somma su un tratto è l&#39;eccesso&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;font-size: 16px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;cumulato delle sue ore.&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="1370" x="320" y="470" as="geometry" />
        </mxCell>
